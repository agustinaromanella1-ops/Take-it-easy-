{
  "expo": {
    "name": "Listo para enviar",
    "slug": "listo-para-enviar",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "listoparaenviar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.takeiteasy.listoparaenviar",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSContactsUsageDescription": "Para elegir a quién mandarle el mensaje desde tu agenda. Los contactos no salen del teléfono."
      }
    },
    "android": {
      "package": "com.takeiteasy.listoparaenviar",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_CONTACTS",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123f3c"
      }
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Para elegir a quién mandarle el mensaje desde tu agenda."
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ddf2ec",
          "dark": {
            "backgroundColor": "#0e2321"
          }
        }
      ]
    ],
    "backgroundColor": "#f1ecf9",
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "dark-content"
    },
    "icon": "./assets/icon.png"
  }
}
