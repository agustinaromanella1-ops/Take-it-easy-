# Reglas de caché de la carpeta compilada. Las leen tanto Cloudflare como
# Netlify con este mismo formato.
#
# El archivo hermano, _redirects, ya no está: llevaba "/* -> /index.html 200"
# para que recargar dentro de la app no diera 404, pero Cloudflare rechaza esa
# regla como un bucle infinito, porque en Workers ese trabajo lo hace
# "not_found_handling" en wrangler.jsonc. En Netlify lo sigue haciendo
# netlify.toml. Pedirlo por los dos caminos a la vez era el error.

# Los archivos con hash en el nombre nunca cambian de contenido.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker y el index NO se cachean: son los que avisan que hay una
# versión nueva. Si el navegador los guarda, la app queda congelada en la
# versión vieja aunque se publique una nueva.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
