<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sin copia de seguridad automática: los datos de la app incluyen nombres
         de alumnos y no salen del dispositivo. La red de seguridad es la
         exportación manual desde Ajustes. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- El plugin de notificaciones declara la alarma exacta, y el proyecto
         decidió no pedirla: los recordatorios son inexactos a propósito. La
         alarma exacta obliga a mandar a la docente a una pantalla de ajustes
         del sistema a dar un permiso especial, y para "acordate de llevar los
         mapas" no vale la pena. Puede llegar unos minutos más tarde. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <!-- El micrófono, para dictar una observación. Lo declara el plugin de
         dictado; se escribe también acá para que un permiso de este tamaño se
         vea en el repositorio y no llegue callado desde node_modules.

         El audio no sale del teléfono: la app pide reconocimiento en el
         dispositivo y, si no lo hay, no enciende el micrófono (1.2). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
